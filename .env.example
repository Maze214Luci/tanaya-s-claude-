# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings -> API). Run supabase/schema.sql against that project
# first (SQL editor, or `supabase db push`).
#
# Without these set, the app runs in demo mode against an in-browser,
# localStorage-backed store seeded with sample household data — every
# workflow in the PRD is clickable, nothing is persisted server-side.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
